<!-- FairEmail Plus: text for the extensions. English only for now. -->
<resources>
    <string name="ext_title" translatable="false">Extensions</string>
    <string name="ext_hint" translatable="false">Added by FairEmail Plus. They only send anything when you use them.</string>
    <string name="ext_addy_settings" translatable="false">addy.io</string>
    <string name="ext_addy_summary" translatable="false">Send from your addy.io aliases, and get stopped before an email shows your real address.</string>
    <string name="ext_addy_key" translatable="false">addy.io API key</string>
    <string name="ext_addy_key_hint" translatable="false">Create one under Settings → API Keys on addy.io. It\'s kept on this phone only, apart from FairEmail\'s settings, so it isn\'t in exports, logs or debug info. Use one you can revoke.</string>
    <string name="ext_addy_server" translatable="false">Server</string>
    <string name="ext_addy_server_hint" translatable="false">Only change this if you host addy.io yourself.</string>
    <string name="ext_addy_guard" translatable="false">Check emails before sending</string>
    <string name="ext_addy_guard_hint" translatable="false">Stops a send if it would show your real address, and says why. The email stays on your phone: only an alias that needs confirming as yours is looked up on addy.io.</string>
    <string name="ext_addy_warn_direct" translatable="false">Also warn when an email doesn\'t go through an alias</string>
    <string name="ext_addy_warn_direct_hint" translatable="false">Asks before any email goes out from your real address. It needs an API key.</string>
    <string name="ext_addy_trusted" translatable="false">Send without asking to</string>
    <string name="ext_addy_trusted_hint" translatable="false">Addresses or domains, one per line. Only the warning above skips them.</string>
