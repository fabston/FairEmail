<?xml version="1.0" encoding="utf-8"?>
<!-- FairEmail Plus: the Extensions card at the top of Settings → Integrations. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="3dp"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="?attr/colorCardBackground"
    app:cardCornerRadius="6dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ext_title"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ext_hint"
            android:textAppearance="@style/TextAppearance.AppCompat.Small" />

        <Button
            android:id="@+id/btnExtAddy"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawableStart="@drawable/twotone_alternate_email_24"
            android:drawablePadding="6dp"
            android:text="@string/ext_addy_settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ext_addy_summary"
            android:textAppearance="@style/TextAppearance.AppCompat.Small" />

        <Button
            android:id="@+id/btnExtAi"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawableStart="@drawable/twotone_auto_fix_high_24"
            android:drawablePadding="6dp"
            android:text="@string/ext_ai_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ext_ai_summary"
            android:textAppearance="@style/TextAppearance.AppCompat.Small" />

        <Button
            android:id="@+id/btnExtGokapi"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawableStart="@drawable/twotone_file_upload_24"
            android:drawablePadding="6dp"
            android:text="@string/ext_gokapi_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ext_gokapi_summary"
            android:textAppearance="@style/TextAppearance.AppCompat.Small" />

        <!-- Only shown in builds from the GitHub workflow, as only they can check for newer ones. -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swExtUpdates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ext_updates"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvExtUpdatesHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ext_updates_hint"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:visibility="gone" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
